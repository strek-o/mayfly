@using Mayfly.Core.Data
@using Mayfly.Core.Files
@using Mayfly.Web.Files
@using Mayfly.Web.Time
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject FileStorage Storage
@inject NavigationManager Navigation

<Window Title="@File.FileName" CloseHref="@CloseHref"
        Expires="@File.ExpiresAt?.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">
    <div class="when">
        @if (File.ExpiresAt is { } expiresAt)
        {
            <span class="stamp @(TimeLeft.IsSoon(expiresAt, Now) ? "stamp-soon" : null)" data-time-left-stamp>@TimeLeft.Format(expiresAt, Now) left</span>
            <small>gone <LocalTime Value="expiresAt" /></small>
        }
        else
        {
            <span class="stamp">No expiry</span>
        }
    </div>

    <dl>
        <dt>Size</dt>
        <dd>@FileSize.Format(File.Size)</dd>
        <dt>Type</dt>
        <dd>@File.ContentType</dd>
        <dt>Uploaded</dt>
        <dd><LocalTime Value="File.UploadedAt!.Value" /></dd>
    </dl>

    @if (Folders.Count > 0)
    {
        <form class="move" data-move-file="@File.Id">
            <label>
                Folder
                <select name="FolderId">
                    <option value="" selected="@(File.FolderId is null)">Desktop</option>
                    @foreach (var folder in Folders)
                    {
                        <option value="@folder.Id" selected="@(File.FolderId == folder.Id)">@folder.Name</option>
                    }
                </select>
            </label>
            <button type="submit" class="button-quiet">Move</button>
        </form>
    }

    <div class="actions">
        <a class="button" href="files/@File.Id/download" data-enhance-nav="false">Download</a>
        <form method="post" @formname="delete-file" @onsubmit="DeleteAsync" data-confirm="Delete this file with all its links?">
            <AntiforgeryToken />
            <button type="submit" class="button-danger">Delete</button>
        </form>
    </div>

    <ShareLinksPanel FileId="File.Id" />
</Window>

@code {
    [Parameter, EditorRequired]
    public FileItem File { get; set; } = default!;

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    [Parameter, EditorRequired]
    public string CloseHref { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<Folder> Folders { get; set; } = default!;

    private async Task DeleteAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Files.Where(f => f.Id == File.Id && f.OwnerId == File.OwnerId).DeleteWithBlobsAsync(db, Storage);

        Navigation.NavigateTo(CloseHref);
    }
}
