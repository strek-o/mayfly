@using Mayfly.Web.Data
@using Mayfly.Web.Pastes
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<nav>
    <NavLink href="pastes" Match="NavLinkMatch.Prefix">My pastes</NavLink>

    <ul>
        @foreach (var paste in pastes)
        {
            <li>
                <NavLink href="@($"pastes/{paste.Id}")" Match="NavLinkMatch.Prefix">@paste.Title</NavLink>

                @if (paste.Id == currentPasteId && threads.Count > 0)
                {
                    <ul>
                        @foreach (var thread in threads)
                        {
                            <li>
                                <NavLink href="@($"pastes/{paste.Id}/threads/{thread.Id}")">@thread.Title</NavLink>
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private List<NavItem> pastes = [];

    private List<NavItem> threads = [];

    private Guid? currentPasteId;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        var ownerId = UserManager.GetUserId(user);
        if (ownerId is null)
        {
            return;
        }

        var segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Split('/');
        if (segments is ["pastes", var pasteSegment, ..] && Guid.TryParse(pasteSegment, out var pasteId))
        {
            currentPasteId = pasteId;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        pastes = await db.Pastes
            .Where(paste => paste.OwnerId == ownerId)
            .WhereNotExpired(DateTimeOffset.UtcNow)
            .OrderByDescending(paste => paste.CreatedAt)
            .Select(paste => new NavItem(paste.Id, paste.Title))
            .ToListAsync();

        if (pastes.Any(paste => paste.Id == currentPasteId))
        {
            threads = await db.Threads
                .Where(thread => thread.PasteId == currentPasteId)
                .OrderBy(thread => thread.CreatedAt)
                .Select(thread => new NavItem(thread.Id, thread.Title))
                .ToListAsync();
        }
    }

    private sealed record NavItem(Guid Id, string Title);
}
