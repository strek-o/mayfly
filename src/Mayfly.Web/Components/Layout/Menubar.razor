@using Mayfly.Core.Data
@using Mayfly.Web.Files
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager

<header class="menubar">
    <a class="wordmark" href="">Mayfly</a>

    <nav class="modes" aria-label="Mode">
        <NavLink href="pastes" Match="NavLinkMatch.Prefix">Paste</NavLink>
        <NavLink href="desktop" Match="NavLinkMatch.Prefix">Desktop</NavLink>
    </nav>

    <p class="quota">
        @FileSize.Format(usedBytes) of @FileSize.Format(FileQuota.MaxBytesPerUser)
        <span class="quota-bar" aria-hidden="true"><span style="width: @(UsedPercent)%"></span></span>
    </p>

    <SectionOutlet SectionName="menubar-actions" />

    <details class="account" data-menu>
        <summary aria-label="Account">@Initial</summary>
        <div class="account-menu">
            <p>@email</p>
            <form action="account/logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="button-quiet">Sign out</button>
            </form>
        </div>
    </details>
</header>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string email = "";

    private long usedBytes;

    private int UsedPercent => (int)Math.Min(100, usedBytes * 100 / FileQuota.MaxBytesPerUser);

    private string Initial => email.Length > 0 ? char.ToUpperInvariant(email[0]).ToString() : "?";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        email = user.Identity?.Name ?? "";
        var ownerId = UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Signed-in user has no id claim.");

        await using var db = await DbFactory.CreateDbContextAsync();
        usedBytes = await db.Files.GetUsedBytesAsync(ownerId, DateTimeOffset.UtcNow);
    }
}
