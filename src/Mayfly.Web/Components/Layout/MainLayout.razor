@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <Menubar />
    </Authorized>
    <NotAuthorized>
        <header class="guest">
            Not signed in · <a href="account/login">Sign in</a> · <a href="account/register">Register</a>
        </header>
    </NotAuthorized>
</AuthorizeView>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
