@page "/pastes"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Mayfly.Web.Data
@using Mayfly.Web.Pastes
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>My pastes</PageTitle>

<h1>My pastes</h1>

<EditForm Model="Input" FormName="create-paste" OnValidSubmit="CreateAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (error is not null)
    {
        <p>@error</p>
    }

    <label>
        Title
        <InputText @bind-Value="Input.Title" />
    </label>

    <label>
        Expires
        <InputSelect @bind-Value="Input.Lifetime">
            <option value="@PasteLifetime.Forever">Never</option>
            <option value="@PasteLifetime.OneHour">In 1 hour</option>
            <option value="@PasteLifetime.OneDay">In 1 day</option>
            <option value="@PasteLifetime.SevenDays">In 7 days</option>
            <option value="@PasteLifetime.Custom">Custom date</option>
        </InputSelect>
    </label>

    <label class="custom-date">
        Custom date (UTC)
        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Input.CustomExpiresAt" />
    </label>

    <button type="submit">Create paste</button>
</EditForm>

@if (pastes.Count == 0)
{
    <p>No pastes yet.</p>
}
else
{
    <ul>
        @foreach (var paste in pastes)
        {
            <li>
                <a href="pastes/@paste.Id">@paste.Title</a>
                · created @paste.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                · @(paste.ExpiresAt is { } expiresAt ? $"expires {expiresAt:yyyy-MM-dd HH:mm} UTC" : "never expires")
            </li>
        }
    </ul>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private List<Paste> pastes = [];

    private string ownerId = "";

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        var user = (await AuthenticationState).User;
        ownerId = UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Signed-in user has no id claim.");

        await using var db = await DbFactory.CreateDbContextAsync();
        pastes = await db.Pastes
            .AsNoTracking()
            .Where(paste => paste.OwnerId == ownerId)
            .WhereNotExpired(DateTimeOffset.UtcNow)
            .OrderByDescending(paste => paste.CreatedAt)
            .ToListAsync();
    }

    private async Task CreateAsync()
    {
        var now = DateTimeOffset.UtcNow;
        DateTimeOffset? customExpiresAt = Input.CustomExpiresAt is { } custom
            ? new DateTimeOffset(custom, TimeSpan.Zero)
            : null;

        if (Input.Lifetime == PasteLifetime.Custom && !(customExpiresAt > now))
        {
            error = "Custom date must be in the future.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Pastes.Add(new Paste
        {
            OwnerId = ownerId,
            Title = Input.Title.Trim(),
            CreatedAt = now,
            ExpiresAt = PasteExpiration.Calculate(Input.Lifetime, now, customExpiresAt)
        });
        await db.SaveChangesAsync();

        Navigation.NavigateTo("pastes");
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200)]
        public string Title { get; set; } = "";

        public PasteLifetime Lifetime { get; set; } = PasteLifetime.Forever;

        public DateTime? CustomExpiresAt { get; set; }
    }
}
