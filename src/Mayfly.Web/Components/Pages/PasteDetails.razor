@page "/pastes/{Id:guid}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Mayfly.Web.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@if (paste is not null)
{
    <PageTitle>@paste.Title</PageTitle>

    <h1>@paste.Title</h1>

    <p><a href="pastes">Back to my pastes</a></p>

    <h2>Threads</h2>

    @if (paste.Threads.Count == 0)
    {
        <p>No threads yet.</p>
    }
    else
    {
        <ul>
            @foreach (var thread in paste.Threads)
            {
                <li><a href="pastes/@paste.Id/threads/@thread.Id">@thread.Title</a></li>
            }
        </ul>
    }

    <EditForm Model="Input" FormName="create-thread" OnValidSubmit="CreateThreadAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>
            Thread title
            <InputText @bind-Value="Input.Title" />
        </label>

        <button type="submit">Add thread</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private Paste? paste;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        var user = (await AuthenticationState).User;
        var ownerId = UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Signed-in user has no id claim.");

        await using var db = await DbFactory.CreateDbContextAsync();
        paste = await db.Pastes
            .AsNoTracking()
            .Include(p => p.Threads.OrderBy(thread => thread.CreatedAt))
            .SingleOrDefaultAsync(p => p.Id == Id && p.OwnerId == ownerId);

        if (paste is null)
        {
            Navigation.NotFound();
        }
    }

    private async Task CreateThreadAsync()
    {
        if (paste is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Threads.Add(new PasteThread
        {
            PasteId = paste.Id,
            Title = Input.Title.Trim(),
            CreatedAt = DateTimeOffset.UtcNow
        });
        await db.SaveChangesAsync();

        Navigation.NavigateTo($"pastes/{paste.Id}");
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200)]
        public string Title { get; set; } = "";
    }
}
