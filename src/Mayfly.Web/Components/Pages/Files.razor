@page "/files"
@attribute [Authorize]
@using Mayfly.Web.Data
@using Mayfly.Web.Files
@using Mayfly.Web.Time
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager

<PageTitle>My files</PageTitle>

<h1>My files</h1>

<form action="files/uploads" method="post" data-upload data-max-size="@FileUploadEndpoints.MaxFileSize">
    <AntiforgeryToken />

    <label>
        File
        <input type="file" name="file" required />
    </label>

    <label>
        Expires
        <select name="Lifetime" autocomplete="off" data-enables="file-custom-expires-at"
                data-enables-when="@Lifetime.Custom">
            <option value="@Lifetime.Forever">Never</option>
            <option value="@Lifetime.OneHour">In 1 hour</option>
            <option value="@Lifetime.OneDay">In 1 day</option>
            <option value="@Lifetime.SevenDays">In 7 days</option>
            <option value="@Lifetime.Custom">Custom date</option>
        </select>
    </label>

    <label>
        Custom date
        <input type="datetime-local" name="CustomExpiresAt" id="file-custom-expires-at" disabled />
    </label>

    <input type="hidden" name="TimeZone" data-time-zone />

    <button type="submit">Upload</button>

    <p role="status" data-upload-status>Maximum size: @FileSize.Format(FileUploadEndpoints.MaxFileSize)</p>
</form>

@if (files.Count == 0)
{
    <p>No files yet.</p>
}
else
{
    <ul>
        @foreach (var file in files)
        {
            <li>
                <a href="files/@file.Id/download" data-enhance-nav="false">@file.FileName</a>
                · @FileSize.Format(file.Size)
                · uploaded
                <LocalTime Value="file.UploadedAt!.Value" />
                · @if (file.ExpiresAt is { } expiresAt)
                {
                    <text>expires
                        <LocalTime Value="expiresAt" />
                    </text>
                }
                else
                {
                    <text>never expires</text>
                }
            </li>
        }
    </ul>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private List<FileItem> files = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        var ownerId = UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Signed-in user has no id claim.");

        await using var db = await DbFactory.CreateDbContextAsync();
        files = await db.Files
            .AsNoTracking()
            .Where(file => file.OwnerId == ownerId && file.UploadedAt != null)
            .WhereNotExpired(DateTimeOffset.UtcNow)
            .OrderByDescending(file => file.UploadedAt)
            .ToListAsync();
    }
}
