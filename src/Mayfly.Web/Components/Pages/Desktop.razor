@page "/desktop"
@page "/desktop/files/{FileId:guid}"
@page "/desktop/folders/{FolderId:guid}"
@page "/desktop/folders/{FolderId:guid}/files/{FileId:guid}"
@attribute [Authorize]
@layout AppLayout
@using System.ComponentModel.DataAnnotations
@using Mayfly.Core.Data
@using Mayfly.Core.Files
@using Mayfly.Core.Time
@using Mayfly.Web.Files
@using Mayfly.Web.Sharing
@using Mayfly.Web.Time
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject FileStorage Storage

<PageTitle>@(openFile?.FileName ?? folder?.Name ?? "Desktop")</PageTitle>

<SectionContent SectionName="menubar-actions">
    @if (FolderId is null)
    {
        <a class="button button-quiet share-desktop" href="desktop?share=true">Share</a>
    }

    <details class="new-folder" data-menu open="@showFolderForm">
        <summary class="button button-quiet">New folder</summary>

        <EditForm Model="FolderInput" FormName="create-folder" OnValidSubmit="CreateFolderAsync"
                  OnInvalidSubmit="() => showFolderForm = true" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>
                Name
                <InputText @bind-Value="FolderInput.Name" autocomplete="off" />
            </label>

            <button type="submit">Create folder</button>
        </EditForm>
    </details>

    <details class="upload" data-menu>
        <summary class="button">Upload</summary>

        <form action="files/uploads" method="post" data-upload data-max-size="@FileUploadEndpoints.MaxFileSize">
            <AntiforgeryToken />
            <input type="hidden" name="FolderId" value="@FolderId" />

            <label>
                Files
                <input type="file" name="file" multiple />
            </label>

            <label>
                Folder
                <input type="file" name="folder" webkitdirectory />
            </label>

            <label>
                Expires
                <select name="Lifetime" autocomplete="off" data-enables="file-custom-expires-at"
                        data-enables-when="@Lifetime.Custom">
                    <option value="@Lifetime.Forever">Never</option>
                    <option value="@Lifetime.OneHour">In 1 hour</option>
                    <option value="@Lifetime.OneDay">In 1 day</option>
                    <option value="@Lifetime.SevenDays">In 7 days</option>
                    <option value="@Lifetime.Custom">Custom date</option>
                </select>
            </label>

            <label>
                Custom date
                <input type="datetime-local" name="CustomExpiresAt" id="file-custom-expires-at" disabled />
            </label>

            <input type="hidden" name="TimeZone" data-time-zone />

            <button type="submit">Upload</button>

            <p role="status" data-upload-status>Maximum size: @FileSize.Format(FileUploadEndpoints.MaxFileSize)</p>
        </form>
    </details>
</SectionContent>

@if (openFile is not null)
{
    <FileWindow File="openFile" Now="now" CloseHref="@ViewHref" Folders="FolderPaths" />
}
else if (folder is not null && Share)
{
    <Window Title="@folder.Name" CloseHref="@ViewHref">
        <p class="folder-note">
            @(folders.Count + files.Count) @(folders.Count + files.Count == 1 ? "item" : "items"). A link shows visitors
            everything in this folder, including subfolders and anything you add later.
        </p>

        <ShareLinksPanel FolderId="folder.Id" />
    </Window>
}
else if (Share)
{
    <Window Title="Desktop" CloseHref="desktop">
        <p class="folder-note">
            A link shows visitors your whole desktop as you arranged it, with every folder and file, including anything
            you add later. Visitors can open folders and download files, but they can't change anything.
        </p>

        <ShareLinksPanel DesktopOwnerId="@ownerId" />
    </Window>
}
else
{
    <h1 class="visually-hidden">@(folder?.Name ?? "Desktop")</h1>
}

<svg class="visually-hidden" aria-hidden="true">
    <symbol id="file-glyph" viewBox="0 0 46 56">
        <path d="M1.5 1.5h30l13 13v40h-43z" fill="#fff" stroke="#d8d0ea" />
        <path d="M31.5 1.5v13h13" fill="#efeaf8" stroke="#d8d0ea" />
    </symbol>
    <symbol id="folder-glyph" viewBox="0 0 56 46">
        <path d="M1 6a4 4 0 0 1 4-4h15l6 6h25a4 4 0 0 1 4 4v29a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4z" fill="#b8a9e8" />
        <path d="M1 14h54v27a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4z" fill="#e4dcfb" />
    </symbol>
</svg>

@if (folder is not null)
{
    <nav class="path" aria-label="Location">
        <a class="crumb" href="desktop" data-folder-target="">Desktop</a>
        @foreach (var ancestor in allFolders.Ancestors(folder))
        {
            <a class="crumb" href="desktop/folders/@ancestor.Id" data-folder-target="@ancestor.Id">@ancestor.Name</a>
        }
        <span aria-current="page">@folder.Name</span>
        <a class="button button-quiet" href="desktop/folders/@folder.Id?share=true">Share</a>
        <form method="post" @formname="delete-current-folder" @onsubmit="() => DeleteFolderAsync(folder)"
              data-confirm="Delete this folder with everything in it?">
            <AntiforgeryToken />
            <button type="submit" class="button-danger">Delete folder</button>
        </form>
    </nav>
}

<DesktopIcons Folders="folders" Files="files" Now="now" CurrentFileId="FileId" BelowPath="folder is not null"
              FolderHref="@(id => FolderHref(id))" FileHref="@(id => $"{ViewHref}/files/{id}")"
              EmptyText="@(folder is null
                  ? "Your desktop is empty. Drop a file here and choose how long it stays."
                  : "This folder is empty. Drop files here and choose how long they stay.")" />

<p class="drop-hint">Drop files or folders anywhere to upload · up to @FileSize.Format(FileUploadEndpoints.MaxFileSize) each</p>

<div class="drop-zone" data-drop-zone hidden>
    <p>Drop to upload</p>
</div>

<div class="context-menu" role="menu" aria-label="Desktop" data-context-menu="desktop" hidden>
    <button type="button" role="menuitem" data-action="new-folder">New folder</button>
    <button type="button" role="menuitem" data-action="upload">Upload files</button>
    <button type="button" role="menuitem" data-action="upload-folder">Upload folder</button>
    <a role="menuitem" href="@ViewHref?share=true">@(folder is null ? "Share desktop" : "Share folder")</a>
</div>

<div class="context-menu" role="menu" aria-label="File" data-context-menu="file" hidden>
    <a role="menuitem" data-from="href">Open</a>
    <a role="menuitem" data-from="download" data-enhance-nav="false">Download</a>
    <form method="post" @formname="delete-desktop-file" @onsubmit="DeleteFileAsync"
          data-confirm="Delete this file with all its links?">
        <AntiforgeryToken />
        <input type="hidden" name="DeleteFileId" data-from="fileId" />
        <button type="submit" role="menuitem">Delete</button>
    </form>
</div>

<div class="context-menu" role="menu" aria-label="Folder" data-context-menu="folder" hidden>
    <a role="menuitem" data-from="href">Open</a>
    <a role="menuitem" data-from="share">Share</a>
    <form method="post" @formname="delete-folder"
          @onsubmit="() => DeleteFolderAsync(allFolders.SingleOrDefault(f => f.Id == DeleteFolderId))"
          data-confirm="Delete this folder with everything in it?">
        <AntiforgeryToken />
        <input type="hidden" name="DeleteFolderId" data-from="folderTarget" />
        <button type="submit" role="menuitem">Delete</button>
    </form>
</div>

@code {
    [Parameter]
    public Guid? FolderId { get; set; }

    [Parameter]
    public Guid? FileId { get; set; }

    [SupplyParameterFromQuery(Name = "share")]
    public bool Share { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "create-folder")]
    private FolderInputModel FolderInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "delete-desktop-file")]
    private Guid? DeleteFileId { get; set; }

    [SupplyParameterFromForm(FormName = "delete-folder")]
    private Guid? DeleteFolderId { get; set; }

    private List<Folder> allFolders = [];

    private List<(Folder Folder, int Count)> folders = [];

    private List<(FileItem File, string Link)> files = [];

    private Folder? folder;

    private FileItem? openFile;

    private string ownerId = "";

    private bool showFolderForm;

    private readonly DateTimeOffset now = DateTimeOffset.UtcNow;

    private string ViewHref => FolderHref(FolderId);

    private List<(Guid Id, string Path)> FolderPaths =>
        allFolders
            .Select(f => (f.Id, string.Join(" / ", allFolders.Ancestors(f).Append(f).Select(a => a.Name))))
            .OrderBy(f => f.Item2, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        FolderInput ??= new();

        var user = (await AuthenticationState).User;
        ownerId = UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Signed-in user has no id claim.");

        await using var db = await DbFactory.CreateDbContextAsync();
        var content = await DesktopContent.LoadAsync(db, ownerId, FolderId, now);
        allFolders = content.AllFolders;
        folder = content.Current;
        if (FolderId is not null && folder is null)
        {
            Navigation.NotFound();
            return;
        }

        folders = content.Folders;
        var items = content.Files;

        var fileIds = items.Select(file => file.Id).ToList();
        var links = await db.ShareLinks
            .AsNoTracking()
            .Where(link => link.FileId != null && fileIds.Contains(link.FileId.Value))
            .WhereActive(now)
            .ToListAsync();

        files = items
            .Select(file => (file, DescribeLinks(links.Where(link => link.FileId == file.Id).ToList())))
            .ToList();

        if (FileId is { } fileId)
        {
            openFile = items.SingleOrDefault(file => file.Id == fileId);
            if (openFile is null)
            {
                Navigation.NotFound();
            }
        }
    }

    private async Task CreateFolderAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Folders.Add(new Folder
        {
            OwnerId = ownerId,
            ParentId = folder?.Id,
            Name = FolderInput.Name.Trim(),
            ExpiresAt = folder?.ExpiresAt,
            CreatedAt = DateTimeOffset.UtcNow
        });
        await db.SaveChangesAsync();

        Navigation.NavigateTo(ViewHref);
    }

    private async Task DeleteFileAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var deleted = await db.Files
            .Where(file => file.Id == DeleteFileId && file.OwnerId == ownerId)
            .DeleteWithBlobsAsync(db, Storage);

        if (deleted == 0)
        {
            Navigation.NotFound();
            return;
        }

        Navigation.NavigateTo(ViewHref);
    }

    private async Task DeleteFolderAsync(Folder? target)
    {
        if (target is null)
        {
            Navigation.NotFound();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var ownerFolders = await db.Folders.AsNoTracking().Where(f => f.OwnerId == ownerId).ToListAsync();
        var ids = ownerFolders.Subtree(target.Id).Select(f => f.Id).ToList();
        await db.Files
            .Where(file => file.FolderId != null && ids.Contains(file.FolderId.Value) && file.OwnerId == ownerId)
            .DeleteWithBlobsAsync(db, Storage);
        await db.ShareLinks.Where(link => link.FolderId != null && ids.Contains(link.FolderId.Value)).ExecuteDeleteAsync();
        await db.Folders.Where(f => ids.Contains(f.Id) && f.OwnerId == ownerId).ExecuteDeleteAsync();

        Navigation.NavigateTo(FolderId is { } current && ids.Contains(current) ? FolderHref(target.ParentId) : ViewHref);
    }

    private static string FolderHref(Guid? folderId) => folderId is { } id ? $"desktop/folders/{id}" : "desktop";

    private static string DescribeLinks(List<ShareLink> links) => links switch
    {
        [] => "Not shared",
        [var link] => string.Join(" · ", new[]
        {
            link.MaxViews is { } maxViews
                ? $"{maxViews - link.ViewCount} {(maxViews - link.ViewCount == 1 ? "view" : "views")} left"
                : "no view limit",
            link.PasswordHash is not null ? "password" : null
        }.OfType<string>()),
        _ => $"{links.Count} active links"
    };

    private sealed class FolderInputModel
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = "";
    }
}
