@page "/desktop"
@page "/desktop/files/{FileId:guid}"
@attribute [Authorize]
@layout AppLayout
@using Mayfly.Core.Data
@using Mayfly.Core.Time
@using Mayfly.Web.Files
@using Mayfly.Web.Sharing
@using Mayfly.Web.Time
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>@(openFile?.FileName ?? "Desktop")</PageTitle>

<SectionContent SectionName="menubar-actions">
    <details class="upload" data-menu>
        <summary class="button">Upload</summary>

        <form action="files/uploads" method="post" data-upload data-max-size="@FileUploadEndpoints.MaxFileSize">
            <AntiforgeryToken />

            <label>
                Files
                <input type="file" name="file" multiple required />
            </label>

            <label>
                Expires
                <select name="Lifetime" autocomplete="off" data-enables="file-custom-expires-at"
                        data-enables-when="@Lifetime.Custom">
                    <option value="@Lifetime.Forever">Never</option>
                    <option value="@Lifetime.OneHour">In 1 hour</option>
                    <option value="@Lifetime.OneDay">In 1 day</option>
                    <option value="@Lifetime.SevenDays">In 7 days</option>
                    <option value="@Lifetime.Custom">Custom date</option>
                </select>
            </label>

            <label>
                Custom date
                <input type="datetime-local" name="CustomExpiresAt" id="file-custom-expires-at" disabled />
            </label>

            <input type="hidden" name="TimeZone" data-time-zone />

            <button type="submit">Upload</button>

            <p role="status" data-upload-status>Maximum size: @FileSize.Format(FileUploadEndpoints.MaxFileSize)</p>
        </form>
    </details>
</SectionContent>

@if (openFile is null)
{
    <h1 class="visually-hidden">Desktop</h1>
}
else
{
    <FileWindow File="openFile" Now="now" />
}

<svg class="visually-hidden" aria-hidden="true">
    <symbol id="file-glyph" viewBox="0 0 46 56">
        <path d="M1.5 1.5h30l13 13v40h-43z" fill="#fff" stroke="#d8d0ea" />
        <path d="M31.5 1.5v13h13" fill="#efeaf8" stroke="#d8d0ea" />
    </symbol>
</svg>

<ul class="desktop">
    @foreach (var (file, link) in files)
    {
        var soon = TimeLeft.IsSoon(file.ExpiresAt, now);
        var extension = Path.GetExtension(file.FileName).TrimStart('.').ToUpperInvariant();
        var timeLeft = file.ExpiresAt is { } expiry ? TimeLeft.Format(expiry, now) : null;

        <li class="item @(soon ? "soon" : null)"
            data-expires="@file.ExpiresAt?.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">
            <a href="desktop/files/@file.Id" aria-describedby="card-@file.Id"
               aria-current="@(file.Id == FileId ? "true" : null)" data-download="files/@file.Id/download">
                <span class="glyph">
                    <svg aria-hidden="true"><use href="#file-glyph" /></svg>
                    @if (extension is { Length: > 0 and <= 4 })
                    {
                        <b>@extension</b>
                    }
                </span>
                <span class="text">
                    <span class="name">@file.FileName</span>
                    <span class="meta">@FileSize.Format(file.Size)</span>
                </span>
                <span class="left" data-time-left>@(timeLeft ?? "stays")</span>
            </a>

            <div class="card" id="card-@file.Id" role="tooltip">
                <header>
                    <b>@file.FileName</b>
                    <span>@(extension.Length > 0 ? $"{extension} file" : "File")</span>
                </header>

                <div class="when">
                    @if (file.ExpiresAt is { } expiresAt)
                    {
                        <span class="stamp @(soon ? "stamp-soon" : null)" data-time-left-stamp>@timeLeft left</span>
                        <small>gone <LocalTime Value="expiresAt" /></small>
                    }
                    else
                    {
                        <span class="stamp">No expiry</span>
                    }
                </div>

                <dl>
                    <dt>Size</dt>
                    <dd>@FileSize.Format(file.Size)</dd>
                    <dt>Uploaded</dt>
                    <dd><LocalTime Value="file.UploadedAt!.Value" /></dd>
                    <dt>Link</dt>
                    <dd>@link</dd>
                </dl>

                <footer>Click to open · double-click to download</footer>
            </div>
        </li>
    }
</ul>

<p class="empty">Your desktop is empty. Drop a file here and choose how long it stays.</p>

<p class="drop-hint">Drop files anywhere to upload · up to @FileSize.Format(FileUploadEndpoints.MaxFileSize) each</p>

<div class="drop-zone" data-drop-zone hidden>
    <p>Drop to upload</p>
</div>

@code {
    [Parameter]
    public Guid? FileId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private List<(FileItem File, string Link)> files = [];

    private FileItem? openFile;

    private readonly DateTimeOffset now = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        var ownerId = UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Signed-in user has no id claim.");

        await using var db = await DbFactory.CreateDbContextAsync();
        var items = await db.Files
            .AsNoTracking()
            .Where(file => file.OwnerId == ownerId && file.UploadedAt != null)
            .WhereNotExpired(now)
            .OrderBy(file => file.ExpiresAt == null)
            .ThenBy(file => file.ExpiresAt)
            .ThenByDescending(file => file.UploadedAt)
            .ToListAsync();

        var fileIds = items.Select(file => file.Id).ToList();
        var links = await db.ShareLinks
            .AsNoTracking()
            .Where(link => link.FileId != null && fileIds.Contains(link.FileId.Value))
            .WhereActive(now)
            .ToListAsync();

        files = items
            .Select(file => (file, DescribeLinks(links.Where(link => link.FileId == file.Id).ToList())))
            .ToList();

        if (FileId is { } fileId)
        {
            openFile = items.SingleOrDefault(file => file.Id == fileId);
            if (openFile is null)
            {
                Navigation.NotFound();
            }
        }
    }

    private static string DescribeLinks(List<ShareLink> links) => links switch
    {
        [] => "Not shared",
        [var link] => string.Join(" · ", new[]
        {
            link.MaxViews is { } maxViews
                ? $"{maxViews - link.ViewCount} {(maxViews - link.ViewCount == 1 ? "view" : "views")} left"
                : "no view limit",
            link.PasswordHash is not null ? "password" : null
        }.OfType<string>()),
        _ => $"{links.Count} active links"
    };
}
