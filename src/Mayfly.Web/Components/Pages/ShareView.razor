@page "/s/{Token}"
@using Mayfly.Core.Data
@using Mayfly.Web.Files
@using Mayfly.Web.Time
@using Mayfly.Web.Sharing
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject ShareSession Session
@inject NavigationManager Navigation

<PageTitle>Shared content</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (content is not null)
{
    <h1>@content.Title</h1>

    @foreach (var thread in content.Threads)
    {
        <section>
            <h2>@thread.Title</h2>

            @if (thread.Entries.Count == 0)
            {
                <p>No entries yet.</p>
            }

            @foreach (var entry in thread.Entries)
            {
                <article id="entry-@entry.Id">
                    <pre>@entry.Content</pre>
                    <small>@(entry.AuthorName ?? "Owner") ·
                        <LocalTime Value="entry.CreatedAt" />
                    </small>
                </article>
            }
        </section>
    }

    @if (link!.CanAppend && content.Threads.Count > 0)
    {
        <form method="post" action="@($"s/{Token}/entries")">
            <AntiforgeryToken />

            <h2>Add an entry</h2>

            @if (content.Threads.Count == 1)
            {
                <input type="hidden" name="ThreadId" value="@content.Threads[0].Id" />
            }
            else
            {
                <label>
                    Thread
                    <select name="ThreadId">
                        @foreach (var thread in content.Threads)
                        {
                            <option value="@thread.Id">@thread.Title</option>
                        }
                    </select>
                </label>
            }

            <label>
                Your name (optional)
                <input name="AuthorName" maxlength="@GuestEntryEndpoint.MaxAuthorNameLength" />
            </label>

            <label>
                Entry
                <textarea name="Content" rows="8" required maxlength="@GuestEntryEndpoint.MaxContentLength"></textarea>
            </label>

            <button type="submit">Add entry</button>
        </form>
    }
}
else if (sharedFile is not null)
{
    <h1>@sharedFile.FileName</h1>

    <p>@FileSize.Format(sharedFile.Size)</p>

    <form method="post" action="@($"s/{Token}/download")">
        <AntiforgeryToken />
        <button type="submit">Download</button>
    </form>
}
else if (link is not null)
{
    <h1>Shared content</h1>

    @if (SessionStatus == "expired")
    {
        <p>Your session has expired. Open the content again to continue.</p>
    }

    @if (link.MaxViews is { } maxViews)
    {
        var remaining = maxViews - link.ViewCount;
        <p>
            @(remaining == 1
                ? "This link works only once. After you open it, nobody else can."
                : $"This link can be opened {remaining} more times.")
        </p>
    }

    <form method="post" @formname="reveal" @onsubmit="RevealAsync">
        <AntiforgeryToken />

        @if (link.PasswordHash is not null)
        {
            @if (passwordRejected)
            {
                <p>Wrong password.</p>
            }

            <label>
                Password
                <input type="password" name="Password" autocomplete="off" />
            </label>
        }

        <button type="submit">Show content</button>
    </form>
}

@code {
    [Parameter]
    public string Token { get; set; } = "";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionStatus { get; set; }

    [SupplyParameterFromForm(FormName = "reveal")]
    private string? Password { get; set; }

    private ShareLink? link;

    private SharedContent? content;

    private SharedFile? sharedFile;

    private bool passwordRejected;

    protected override async Task OnInitializedAsync()
    {
        if (ShareToken.IsWellFormed(Token))
        {
            var tokenHash = ShareToken.Hash(Token);
            var now = DateTimeOffset.UtcNow;

            await using var db = await DbFactory.CreateDbContextAsync();
            link = await db.ShareLinks
                .AsNoTracking()
                .Where(l => l.TokenHash == tokenHash)
                .WhereOpen(now)
                .WhereTargetAvailable(db, now)
                .SingleOrDefaultAsync();

            if (link is not null && Session.IsActive(HttpContext, link.Id))
            {
                Session.Start(HttpContext, link.Id, Token);
                if (link.FileId is { } fileId)
                {
                    sharedFile = await db.Files
                        .Where(file => file.Id == fileId)
                        .Select(file => new SharedFile(file.FileName, file.Size))
                        .SingleAsync();
                }
                else
                {
                    content = await LoadContentAsync(db, link);
                }

                return;
            }

            if (link?.GetStatus(now) != ShareLinkStatus.Active)
            {
                link = null;
            }
        }

        if (link is null)
        {
            Navigation.NotFound();
        }
    }

    private async Task RevealAsync()
    {
        if (link is null)
        {
            return;
        }

        if (!ShareLinkPassword.Verify(link, Password))
        {
            passwordRejected = true;
            return;
        }

        var linkId = link.Id;
        var now = DateTimeOffset.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var consumed = await db.ShareLinks
            .Where(l => l.Id == linkId)
            .WhereActive(now)
            .WhereTargetAvailable(db, now)
            .ExecuteUpdateAsync(setters => setters.SetProperty(l => l.ViewCount, l => l.ViewCount + 1));

        if (consumed == 0)
        {
            link = null;
            Navigation.NotFound();
            return;
        }

        Session.Start(HttpContext, linkId, Token);
        Navigation.NavigateTo($"s/{Token}");
    }

    private static async Task<SharedContent> LoadContentAsync(MayflyDbContext db, ShareLink link)
    {
        var pasteId = link.PasteId;
        var threadId = link.ThreadId;

        var title = await db.Pastes
            .Where(paste => paste.Id == pasteId)
            .Select(paste => paste.Title)
            .SingleAsync();

        var threads = await db.Threads
            .AsNoTracking()
            .Where(thread => thread.PasteId == pasteId && (threadId == null || thread.Id == threadId))
            .Include(thread => thread.Entries.OrderBy(entry => entry.CreatedAt))
            .OrderBy(thread => thread.CreatedAt)
            .ToListAsync();

        return new SharedContent(title, threads);
    }

    private sealed record SharedContent(string Title, List<PasteThread> Threads);

    private sealed record SharedFile(string FileName, long Size);
}
