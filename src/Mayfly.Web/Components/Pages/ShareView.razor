@page "/s/{Token}"
@layout BareLayout
@using Mayfly.Core.Data
@using Mayfly.Core.Time
@using Mayfly.Web.Files
@using Mayfly.Web.Time
@using Mayfly.Web.Sharing
@using Microsoft.AspNetCore.RateLimiting
@using Microsoft.EntityFrameworkCore
@attribute [EnableRateLimiting(ShareLinkRateLimit.PolicyName)]
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject ShareSession Session
@inject NavigationManager Navigation

<PageTitle>@(content?.Title ?? sharedFolder?.Current.Name ?? sharedFile?.FileName ?? DesktopTitle ?? "Shared with you")</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<svg class="visually-hidden" aria-hidden="true">
    <symbol id="file-glyph" viewBox="0 0 46 56">
        <path d="M1.5 1.5h30l13 13v40h-43z" fill="#fff" stroke="#d8d0ea" />
        <path d="M31.5 1.5v13h13" fill="#efeaf8" stroke="#d8d0ea" />
    </symbol>
    <symbol id="folder-glyph" viewBox="0 0 56 46">
        <path d="M1 6a4 4 0 0 1 4-4h15l6 6h25a4 4 0 0 1 4 4v29a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4z" fill="#b8a9e8" />
        <path d="M1 14h54v27a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4z" fill="#e4dcfb" />
    </symbol>
</svg>

@if (content is not null)
{
    var current = content.Threads.FirstOrDefault(thread => thread.Id == ThreadId) ?? content.Threads.FirstOrDefault();

    <header class="guest-bar">
        <a class="brand" href="">Mayfly</a>
        <span>Shared with you</span>
    </header>

    <main class="paste panel" data-expires="@Utc(content.ExpiresAt)">
        <header>
            <h1>@content.Title</h1>
            @Stamp(content.ExpiresAt)
        </header>

        <nav class="tabs" aria-label="Threads">
            @foreach (var thread in content.Threads)
            {
                <a href="@($"s/{Token}?thread={thread.Id}")" aria-current="@(thread == current ? "page" : null)">@thread.Title</a>
            }
        </nav>

        @if (current is null || current.Entries.Count == 0)
        {
            <p class="empty">@(link!.CanAppend && current is not null ? "No entries yet. Write the first one below." : "No entries yet.")</p>
        }
        else
        {
            <EntryList Entries="current.Entries" OwnerName="Owner" />
        }

        @if (link!.CanAppend && current is not null)
        {
            <form method="post" action="@($"s/{Token}/entries")" class="composer">
                <AntiforgeryToken />
                <input type="hidden" name="ThreadId" value="@current.Id" />

                <EntryEditor Name="Content">
                    <input class="author" name="AuthorName" maxlength="@GuestEntryEndpoint.MaxAuthorNameLength"
                           placeholder="Your name (optional)" aria-label="Your name" autocomplete="name" />
                </EntryEditor>
            </form>
        }
    </main>
}
else if (sharedFolder is not null)
{
    var count = sharedFolder.Children.Count + sharedFolder.Files.Count;

    <header class="guest-bar">
        <a class="brand" href="">Mayfly</a>
        <span>Shared with you</span>
    </header>

    <main class="folder panel">
        <header>
            @foreach (var ancestor in sharedFolder.Path)
            {
                <a class="crumb" href="@($"s/{Token}?folder={ancestor.Id}")">@ancestor.Name</a>
            }
            <h1>@sharedFolder.Current.Name</h1>
            <span>@count @(count == 1 ? "item" : "items")</span>
        </header>

        @if (count == 0)
        {
            <p class="empty">This folder is empty.</p>
        }
        else
        {
            <form method="post" action="@($"s/{Token}/download")">
                <AntiforgeryToken />

                <ul class="files">
                    @foreach (var child in sharedFolder.Children)
                    {
                        <li>
                            <a class="open" href="@($"s/{Token}?folder={child.Id}")">
                                <span class="glyph"><svg aria-hidden="true"><use href="#folder-glyph" /></svg></span>
                                <span class="text">
                                    <span class="name">@child.Name</span>
                                    <span class="meta">Folder</span>
                                </span>
                            </a>
                        </li>
                    }

                    @foreach (var file in sharedFolder.Files)
                    {
                        <li class="@(TimeLeft.IsSoon(file.ExpiresAt, now) ? "soon" : null)" data-expires="@Utc(file.ExpiresAt)">
                            <span class="glyph"><svg aria-hidden="true"><use href="#file-glyph" /></svg></span>
                            <span class="text">
                                <span class="name">@file.FileName</span>
                                <span class="meta">
                                    @FileSize.Format(file.Size) ·
                                    @if (file.ExpiresAt is { } expiresAt)
                                    {
                                        <span data-time-left>@TimeLeft.Format(expiresAt, now)</span><text> left</text>
                                    }
                                    else
                                    {
                                        <text>stays</text>
                                    }
                                </span>
                            </span>
                            <button type="submit" class="button-quiet" name="FileId" value="@file.Id">Download</button>
                        </li>
                    }
                </ul>
            </form>
        }
    </main>
}
else if (sharedFile is not null)
{
    var extension = Path.GetExtension(sharedFile.FileName).TrimStart('.').ToUpperInvariant();

    <div class="guest-center">
        <a class="brand" href="">Mayfly</a>

        <section class="panel card" data-expires="@Utc(sharedFile.ExpiresAt)">
            <span class="glyph">
                <svg aria-hidden="true"><use href="#file-glyph" /></svg>
                @if (extension is { Length: > 0 and <= 4 })
                {
                    <b>@extension</b>
                }
            </span>

            <h1>@sharedFile.FileName</h1>
            @Stamp(sharedFile.ExpiresAt)

            <dl>
                <dt>Size</dt>
                <dd>@FileSize.Format(sharedFile.Size)</dd>
                <dt>Type</dt>
                <dd>@(extension.Length > 0 ? $"{extension} file" : "File")</dd>
            </dl>

            <form method="post" action="@($"s/{Token}/download")">
                <AntiforgeryToken />
                <button type="submit">Download</button>
            </form>
        </section>
    </div>
}
else if (sharedDesktop is not null)
{
    var current = sharedDesktop.Current;
    var viewHref = current is null ? $"s/{Token}" : $"s/{Token}?folder={current.Id}";

    <header class="guest-bar">
        <a class="brand" href="">Mayfly</a>
        <span>Shared with you</span>
    </header>

    @if (current is not null)
    {
        <nav class="path" aria-label="Location">
            <a class="crumb" href="@($"s/{Token}")">Desktop</a>
            @foreach (var ancestor in sharedDesktop.AllFolders.Ancestors(current))
            {
                <a class="crumb" href="@($"s/{Token}?folder={ancestor.Id}")">@ancestor.Name</a>
            }
            <span aria-current="page">@current.Name</span>
        </nav>
    }

    @if (openFile is not null)
    {
        <FileWindow File="openFile" Now="now" CloseHref="@viewHref" Folders="[]" ShareToken="@Token" />
    }
    else
    {
        <h1 class="visually-hidden">@DesktopTitle</h1>
    }

    <DesktopIcons Folders="sharedDesktop.Folders" Files="desktopFiles" Now="now" CurrentFileId="openFile?.Id"
                  BelowPath="current is not null" ReadOnly="true"
                  FolderHref="@(id => $"s/{Token}?folder={id}")"
                  FileHref="@(id => current is null ? $"s/{Token}?file={id}" : $"s/{Token}?folder={current.Id}&file={id}")"
                  EmptyText="@(current is null ? "This desktop is empty." : "This folder is empty.")" />
}
else if (link is not null)
{
    <div class="guest-center">
        <a class="brand" href="">Mayfly</a>

        <section class="panel card">
            @if (link.MaxViews is { } maxViews)
            {
                var remaining = maxViews - link.ViewCount;
                <span class="stamp @(remaining == 1 ? "stamp-soon" : null)">@remaining @(remaining == 1 ? "view" : "views") left</span>
            }

            <h1>Someone shared a @Kind with you</h1>

            @if (link.MaxViews - link.ViewCount == 1)
            {
                <p>This link works only once. After you open it, nobody else can.</p>
            }

            @if (SessionStatus == "expired")
            {
                <p class="form-error" role="alert">Your session has expired. Open the @Kind again to continue.</p>
            }

            <form method="post" @formname="reveal" @onsubmit="RevealAsync">
                <AntiforgeryToken />

                @if (link.PasswordHash is not null)
                {
                    <label>
                        Password
                        <input type="password" name="Password" autocomplete="off" />
                    </label>

                    @if (passwordRejected)
                    {
                        <p class="form-error" role="alert">Wrong password.</p>
                    }
                }

                <button type="submit">Open @Kind</button>
            </form>
        </section>
    </div>
}

@code {
    [Parameter]
    public string Token { get; set; } = "";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionStatus { get; set; }

    [SupplyParameterFromQuery(Name = "thread")]
    public Guid? ThreadId { get; set; }

    [SupplyParameterFromQuery(Name = "folder")]
    public Guid? FolderId { get; set; }

    [SupplyParameterFromQuery(Name = "file")]
    public Guid? OpenFileId { get; set; }

    [SupplyParameterFromForm(FormName = "reveal")]
    private string? Password { get; set; }

    private ShareLink? link;

    private SharedContent? content;

    private SharedFile? sharedFile;

    private SharedFolder? sharedFolder;

    private DesktopContent? sharedDesktop;

    private List<(FileItem File, string Link)> desktopFiles = [];

    private FileItem? openFile;

    private bool passwordRejected;

    private readonly DateTimeOffset now = DateTimeOffset.UtcNow;

    private string Kind =>
        link?.FileId is not null ? "file"
        : link?.FolderId is not null ? "folder"
        : link?.DesktopOwnerId is not null ? "desktop"
        : "paste";

    private string? DesktopTitle => sharedDesktop is null ? null : sharedDesktop.Current?.Name ?? "Desktop";

    protected override async Task OnInitializedAsync()
    {
        if (ShareToken.IsWellFormed(Token))
        {
            var tokenHash = ShareToken.Hash(Token);

            await using var db = await DbFactory.CreateDbContextAsync();
            link = await db.ShareLinks
                .AsNoTracking()
                .Where(l => l.TokenHash == tokenHash)
                .WhereOpen(now)
                .WhereTargetAvailable(db, now)
                .SingleOrDefaultAsync();

            if (link is not null && Session.IsActive(HttpContext, link.Id))
            {
                Session.Start(HttpContext, link.Id, Token);
                if (link.FileId is { } fileId)
                {
                    sharedFile = await db.Files
                        .Where(file => file.Id == fileId)
                        .Select(file => new SharedFile(file.FileName, file.Size, file.ExpiresAt))
                        .SingleAsync();
                }
                else if (link.FolderId is { } folderId)
                {
                    var tree = await db.Folders.LoadTreeAsync(folderId, now);
                    if (tree.Count == 0)
                    {
                        link = null;
                        Navigation.NotFound();
                        return;
                    }

                    var current = tree.Find(folder => folder.Id == FolderId) ?? tree[0];
                    sharedFolder = new SharedFolder(
                        current,
                        tree.Ancestors(current),
                        tree.Where(folder => folder.ParentId == current.Id).OrderBy(folder => folder.Name).ToList(),
                        await db.Files
                            .Where(file => file.FolderId == current.Id && file.UploadedAt != null)
                            .WhereNotExpired(now)
                            .OrderBy(file => file.FileName)
                            .Select(file => new SharedFolderFile(file.Id, file.FileName, file.Size, file.ExpiresAt))
                            .ToListAsync());
                }
                else if (link.DesktopOwnerId is { } desktopOwnerId)
                {
                    sharedDesktop = await DesktopContent.LoadAsync(db, desktopOwnerId, FolderId, now);
                    desktopFiles = sharedDesktop.Files.Select(file => (file, "")).ToList();
                    openFile = sharedDesktop.Files.Find(file => file.Id == OpenFileId);
                }
                else
                {
                    content = await LoadContentAsync(db, link);
                }

                return;
            }

            if (link?.GetStatus(now) != ShareLinkStatus.Active)
            {
                link = null;
            }
        }

        if (link is null)
        {
            Navigation.NotFound();
        }
    }

    private async Task RevealAsync()
    {
        if (link is null)
        {
            return;
        }

        if (!ShareLinkPassword.Verify(link, Password))
        {
            passwordRejected = true;
            return;
        }

        var linkId = link.Id;
        var revealedAt = DateTimeOffset.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var consumed = await db.ShareLinks
            .Where(l => l.Id == linkId)
            .WhereActive(revealedAt)
            .WhereTargetAvailable(db, revealedAt)
            .ExecuteUpdateAsync(setters => setters.SetProperty(l => l.ViewCount, l => l.ViewCount + 1));

        if (consumed == 0)
        {
            link = null;
            Navigation.NotFound();
            return;
        }

        Session.Start(HttpContext, linkId, Token);
        Navigation.NavigateTo($"s/{Token}");
    }

    private RenderFragment Stamp(DateTimeOffset? expiresAt) =>
        @<span class="stamp @(TimeLeft.IsSoon(expiresAt, now) ? "stamp-soon" : null)" data-time-left-stamp>@(expiresAt is { } value ? $"{TimeLeft.Format(value, now)} left" : "No expiry")</span>;

    private static string? Utc(DateTimeOffset? value) => value?.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");

    private static async Task<SharedContent> LoadContentAsync(MayflyDbContext db, ShareLink link)
    {
        var pasteId = link.PasteId;
        var threadId = link.ThreadId;

        var paste = await db.Pastes
            .Where(paste => paste.Id == pasteId)
            .Select(paste => new { paste.Title, paste.ExpiresAt })
            .SingleAsync();

        var threads = await db.Threads
            .AsNoTracking()
            .Where(thread => thread.PasteId == pasteId && (threadId == null || thread.Id == threadId))
            .Include(thread => thread.Entries.OrderBy(entry => entry.CreatedAt))
            .OrderBy(thread => thread.CreatedAt)
            .ToListAsync();

        return new SharedContent(paste.Title, paste.ExpiresAt, threads);
    }

    private sealed record SharedContent(string Title, DateTimeOffset? ExpiresAt, List<PasteThread> Threads);

    private sealed record SharedFile(string FileName, long Size, DateTimeOffset? ExpiresAt);

    private sealed record SharedFolder(Folder Current, List<Folder> Path, List<Folder> Children, List<SharedFolderFile> Files);

    private sealed record SharedFolderFile(Guid Id, string FileName, long Size, DateTimeOffset? ExpiresAt);
}
