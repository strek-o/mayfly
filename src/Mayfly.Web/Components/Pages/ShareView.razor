@page "/s/{Token}"
@using Mayfly.Web.Data
@using Mayfly.Web.Pastes
@using Mayfly.Web.Sharing
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Shared paste</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (content is not null)
{
    <h1>@content.Title</h1>

    @foreach (var thread in content.Threads)
    {
        <section>
            <h2>@thread.Title</h2>

            @if (thread.Entries.Count == 0)
            {
                <p>No entries yet.</p>
            }

            @foreach (var entry in thread.Entries)
            {
                <article>
                    <pre>@entry.Content</pre>
                    <small>@(entry.AuthorName ?? "Owner") ·
                        <LocalTime Value="entry.CreatedAt" />
                    </small>
                </article>
            }
        </section>
    }

    @if (link!.CanAppend && content.Threads.Count > 0)
    {
        @if (content.CanAddEntries)
        {
            <form method="post" action="@($"s/{Token}/entries")">
                <AntiforgeryToken />

                <h2>Add an entry</h2>

                @if (content.Threads.Count == 1)
                {
                    <input type="hidden" name="ThreadId" value="@content.Threads[0].Id" />
                }
                else
                {
                    <label>
                        Thread
                        <select name="ThreadId">
                            @foreach (var thread in content.Threads)
                            {
                                <option value="@thread.Id">@thread.Title</option>
                            }
                        </select>
                    </label>
                }

                <label>
                    Your name (optional)
                    <input name="AuthorName" maxlength="@GuestEntryEndpoint.MaxAuthorNameLength" />
                </label>

                <label>
                    Entry
                    <textarea name="Content" rows="8" required maxlength="@GuestEntryEndpoint.MaxContentLength"></textarea>
                </label>

                @if (link.PasswordHash is not null)
                {
                    <label>
                        Password
                        <input type="password" name="Password" autocomplete="off" />
                    </label>
                }

                <button type="submit">Add entry</button>
            </form>
        }
        else
        {
            <p>This link has no views left, so new entries cannot be added.</p>
        }
    }
}
else if (link is not null)
{
    <h1>Shared paste</h1>

    @if (EntryStatus == "added")
    {
        <p>Your entry was added.</p>
    }
    else if (EntryStatus == "wrong-password")
    {
        <p>Wrong password. Your entry was not added.</p>
    }

    @if (link.MaxViews is { } maxViews)
    {
        var remaining = maxViews - link.ViewCount;
        <p>
            @(remaining == 1
                ? "This link works only once. The content will not be available again after you open it."
                : $"This link can be opened {remaining} more times.")
        </p>
    }

    <form method="post" @formname="reveal" @onsubmit="RevealAsync">
        <AntiforgeryToken />

        @if (link.PasswordHash is not null)
        {
            @if (passwordRejected)
            {
                <p>Wrong password.</p>
            }

            <label>
                Password
                <input type="password" name="Password" autocomplete="off" />
            </label>
        }

        <button type="submit">Show content</button>
    </form>
}

@code {
    [Parameter]
    public string Token { get; set; } = "";

    [SupplyParameterFromQuery(Name = "entry")]
    public string? EntryStatus { get; set; }

    [SupplyParameterFromForm(FormName = "reveal")]
    private string? Password { get; set; }

    private ShareLink? link;

    private SharedContent? content;

    private bool passwordRejected;

    protected override async Task OnInitializedAsync()
    {
        if (ShareToken.IsWellFormed(Token))
        {
            var tokenHash = ShareToken.Hash(Token);
            var now = DateTimeOffset.UtcNow;

            await using var db = await DbFactory.CreateDbContextAsync();
            var livePastes = db.Pastes.WhereNotExpired(now);
            link = await db.ShareLinks
                .AsNoTracking()
                .Where(l => l.TokenHash == tokenHash)
                .WhereActive(now)
                .Where(l => livePastes.Any(paste => paste.Id == l.PasteId))
                .SingleOrDefaultAsync();
        }

        if (link is null)
        {
            Navigation.NotFound();
        }
    }

    private async Task RevealAsync()
    {
        if (link is null)
        {
            return;
        }

        if (!ShareLinkPassword.Verify(link, Password))
        {
            passwordRejected = true;
            return;
        }

        var linkId = link.Id;
        var pasteId = link.PasteId;
        var threadId = link.ThreadId;
        var now = DateTimeOffset.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var livePastes = db.Pastes.WhereNotExpired(now);
        var consumed = await db.ShareLinks
            .Where(l => l.Id == linkId)
            .WhereActive(now)
            .Where(l => livePastes.Any(paste => paste.Id == l.PasteId))
            .ExecuteUpdateAsync(setters => setters.SetProperty(l => l.ViewCount, l => l.ViewCount + 1));

        if (consumed == 0)
        {
            link = null;
            Navigation.NotFound();
            return;
        }

        var title = await db.Pastes
            .Where(paste => paste.Id == pasteId)
            .Select(paste => paste.Title)
            .SingleAsync();

        var threads = await db.Threads
            .AsNoTracking()
            .Where(thread => thread.PasteId == pasteId && (threadId == null || thread.Id == threadId))
            .Include(thread => thread.Entries.OrderBy(entry => entry.CreatedAt))
            .OrderBy(thread => thread.CreatedAt)
            .ToListAsync();

        var canAddEntries = link.MaxViews is null || link.ViewCount + 1 < link.MaxViews;
        content = new SharedContent(title, threads, canAddEntries);
    }

    private sealed record SharedContent(string Title, List<PasteThread> Threads, bool CanAddEntries);
}
