@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using Mayfly.Core.Data
@using Mayfly.Core.Time
@using Mayfly.Web.Sharing
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject ShareTokenProtector TokenProtector
@inject NavigationManager Navigation

<section>
    <h2>Share links</h2>

    <EditForm Model="LinkInput" FormName="create-share-link" OnValidSubmit="CreateAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (PasteId is not null)
        {
            <label>
                <InputCheckbox @bind-Value="LinkInput.CanAppend" />
                Visitors can add entries
            </label>
        }

        <label>
            Link expires
            <InputSelect @bind-Value="LinkInput.Lifetime">
                <option value="@Lifetime.Forever">Never</option>
                <option value="@Lifetime.OneHour">In 1 hour</option>
                <option value="@Lifetime.OneDay">In 1 day</option>
                <option value="@Lifetime.SevenDays">In 7 days</option>
            </InputSelect>
        </label>

        <label>
            View limit (empty = unlimited, 1 = burn after read)
            <InputNumber @bind-Value="LinkInput.MaxViews" min="1" max="1000" />
        </label>

        <label>
            Password (optional)
            <InputText @bind-Value="LinkInput.Password" type="password" autocomplete="new-password" />
        </label>

        <button type="submit">Create link</button>
    </EditForm>

    @if (links.Count == 0)
    {
        <p>No share links yet.</p>
    }
    else
    {
        <form method="post" @formname="revoke-share-link" @onsubmit="RevokeAsync">
            <AntiforgeryToken />

            <table>
                <thead>
                    <tr>
                        <th>Link</th>
                        <th>Created</th>
                        <th>Access</th>
                        <th>Expires</th>
                        <th>Views</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var link in links)
                    {
                        var status = link.GetStatus(now);

                        <tr>
                            <td>
                                @if (status != ShareLinkStatus.Active)
                                {
                                    <text>—</text>
                                }
                                else if (LinkUrl(link) is { } url)
                                {
                                    <input id="share-url-@link.Id" readonly value="@url" size="50" />
                                    <button type="button" data-copy="share-url-@link.Id">Copy</button>
                                }
                                else
                                {
                                    <text>Not available</text>
                                }
                            </td>
                            <td>
                                <LocalTime Value="link.CreatedAt" />
                            </td>
                            <td>@(link.CanAppend ? "Read and add" : "Read only")@(link.PasswordHash is null ? "" : " · password")</td>
                            <td>
                                @if (link.ExpiresAt is { } expiresAt)
                                {
                                    <LocalTime Value="expiresAt" />
                                }
                                else
                                {
                                    <text>Never</text>
                                }
                            </td>
                            <td>@link.ViewCount / @(link.MaxViews?.ToString() ?? "∞")</td>
                            <td>@status</td>
                            <td>
                                @if (status == ShareLinkStatus.Active)
                                {
                                    <button type="submit" name="RevokeId" value="@link.Id">Revoke</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    }
</section>

@code {
    [Parameter]
    public Guid? PasteId { get; set; }

    [Parameter]
    public Guid? ThreadId { get; set; }

    [Parameter]
    public Guid? FileId { get; set; }

    [SupplyParameterFromForm(FormName = "create-share-link")]
    private LinkInputModel LinkInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "revoke-share-link")]
    private Guid? RevokeId { get; set; }

    private List<ShareLink> links = [];

    private DateTimeOffset now;

    protected override async Task OnInitializedAsync()
    {
        if ((PasteId is null) == (FileId is null))
        {
            throw new InvalidOperationException("Share links need either a paste or a file.");
        }

        LinkInput ??= new();
        await LoadLinksAsync();
    }

    private async Task CreateAsync()
    {
        var token = ShareToken.Generate();
        var createdAt = DateTimeOffset.UtcNow;

        var link = new ShareLink
        {
            PasteId = PasteId,
            ThreadId = ThreadId,
            FileId = FileId,
            TokenHash = ShareToken.Hash(token),
            ProtectedToken = TokenProtector.Protect(token),
            CanAppend = PasteId is not null && LinkInput.CanAppend,
            CreatedAt = createdAt,
            ExpiresAt = Expiration.Calculate(LinkInput.Lifetime, createdAt),
            MaxViews = LinkInput.MaxViews
        };

        if (!string.IsNullOrEmpty(LinkInput.Password))
        {
            link.PasswordHash = ShareLinkPassword.Hash(link, LinkInput.Password);
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.ShareLinks.Add(link);
            await db.SaveChangesAsync();
        }

        Navigation.NavigateTo(Navigation.Uri);
    }

    private string? LinkUrl(ShareLink link) =>
        TokenProtector.Unprotect(link.ProtectedToken) is { } token
            ? Navigation.ToAbsoluteUri($"s/{token}").ToString()
            : null;

    private async Task RevokeAsync()
    {
        if (RevokeId is not { } linkId)
        {
            return;
        }

        var revokedAt = DateTimeOffset.UtcNow;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.ShareLinks
                .Where(link => link.Id == linkId)
                .Where(InScope)
                .Where(link => link.RevokedAt == null)
                .ExecuteUpdateAsync(setters => setters.SetProperty(link => link.RevokedAt, revokedAt));
        }

        Navigation.NavigateTo(Navigation.Uri);
    }

    private async Task LoadLinksAsync()
    {
        now = DateTimeOffset.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        links = await db.ShareLinks
            .AsNoTracking()
            .Where(InScope)
            .OrderByDescending(link => link.CreatedAt)
            .ToListAsync();
    }

    private Expression<Func<ShareLink, bool>> InScope =>
        link => link.PasteId == PasteId && link.ThreadId == ThreadId && link.FileId == FileId;

    private sealed class LinkInputModel
    {
        public bool CanAppend { get; set; }

        [AllowedValues(Lifetime.Forever, Lifetime.OneHour, Lifetime.OneDay, Lifetime.SevenDays)]
        public Lifetime Lifetime { get; set; } = Lifetime.SevenDays;

        [Range(1, 1000)]
        public int? MaxViews { get; set; }

        [StringLength(100, MinimumLength = 4)]
        public string? Password
        {
            get;
            set => field = string.IsNullOrEmpty(value) ? null : value;
        }
    }
}
