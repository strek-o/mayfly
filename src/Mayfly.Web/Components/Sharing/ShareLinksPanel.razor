@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using Mayfly.Core.Data
@using Mayfly.Core.Time
@using Mayfly.Web.Sharing
@using Mayfly.Web.Time
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MayflyDbContext> DbFactory
@inject ShareTokenProtector TokenProtector
@inject NavigationManager Navigation

<section class="share">
    <h2>Share links</h2>

    @if (active.Count > 0)
    {
        <form method="post" @formname="revoke-share-link" @onsubmit="RevokeAsync">
            <AntiforgeryToken />

            <ul class="links">
                @foreach (var link in active)
                {
                    <li>
                        <div class="url">
                            @if (LinkUrl(link) is { } url)
                            {
                                <input id="share-url-@link.Id" readonly value="@url" aria-label="Share link" />
                                <button type="button" class="button-quiet" data-copy="share-url-@link.Id">Copy</button>
                            }
                            else
                            {
                                <span>Link not available</span>
                            }
                        </div>

                        <p class="facts">
                            <span>@DescribeViews(link)</span>
                            <span>@DescribeExpiry(link)</span>
                            @if (link.PasswordHash is not null)
                            {
                                <span>password</span>
                            }
                            @if (link.CanAppend)
                            {
                                <span>guests can add entries</span>
                            }
                            <button type="submit" class="button-danger" name="RevokeId" value="@link.Id">Revoke</button>
                        </p>
                    </li>
                }
            </ul>
        </form>
    }

    <details class="new-link" open="@(showForm || active.Count == 0)">
        <summary>New link</summary>

        <EditForm Model="LinkInput" FormName="create-share-link" OnValidSubmit="CreateAsync"
                  OnInvalidSubmit="() => showForm = true" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="fields">
                <label>
                    Link expires
                    <InputSelect @bind-Value="LinkInput.Lifetime">
                        <option value="@Lifetime.Forever">Never</option>
                        <option value="@Lifetime.OneHour">In 1 hour</option>
                        <option value="@Lifetime.OneDay">In 1 day</option>
                        <option value="@Lifetime.SevenDays">In 7 days</option>
                    </InputSelect>
                </label>

                <label>
                    View limit
                    <InputNumber @bind-Value="LinkInput.MaxViews" min="1" max="1000" placeholder="No limit" />
                </label>

                <label>
                    Password
                    <InputText @bind-Value="LinkInput.Password" type="password" autocomplete="new-password"
                               placeholder="Optional" />
                </label>
            </div>

            @if (PasteId is not null)
            {
                <label>
                    <InputCheckbox @bind-Value="LinkInput.CanAppend" />
                    Visitors can add entries
                </label>
            }

            <p class="hint">A view limit of 1 burns the link after the first visit.</p>

            <button type="submit">Create link</button>
        </EditForm>
    </details>

    @if (past.Count > 0)
    {
        <details class="past">
            <summary>Past links (@past.Count)</summary>

            <ul>
                @foreach (var (link, status) in past)
                {
                    <li>
                        <span class="stamp">@DescribeStatus(status)</span>
                        created <LocalTime Value="link.CreatedAt" /> · @link.ViewCount @(link.ViewCount == 1 ? "view" : "views")
                    </li>
                }
            </ul>
        </details>
    }
</section>

@code {
    [Parameter]
    public Guid? PasteId { get; set; }

    [Parameter]
    public Guid? ThreadId { get; set; }

    [Parameter]
    public Guid? FileId { get; set; }

    [SupplyParameterFromForm(FormName = "create-share-link")]
    private LinkInputModel LinkInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "revoke-share-link")]
    private Guid? RevokeId { get; set; }

    private List<ShareLink> active = [];

    private List<(ShareLink Link, ShareLinkStatus Status)> past = [];

    private DateTimeOffset now;

    private bool showForm;

    protected override async Task OnInitializedAsync()
    {
        if ((PasteId is null) == (FileId is null))
        {
            throw new InvalidOperationException("Share links need either a paste or a file.");
        }

        LinkInput ??= new();
        await LoadLinksAsync();
    }

    private async Task CreateAsync()
    {
        var token = ShareToken.Generate();
        var createdAt = DateTimeOffset.UtcNow;

        var link = new ShareLink
        {
            PasteId = PasteId,
            ThreadId = ThreadId,
            FileId = FileId,
            TokenHash = ShareToken.Hash(token),
            ProtectedToken = TokenProtector.Protect(token),
            CanAppend = PasteId is not null && LinkInput.CanAppend,
            CreatedAt = createdAt,
            ExpiresAt = Expiration.Calculate(LinkInput.Lifetime, createdAt),
            MaxViews = LinkInput.MaxViews
        };

        if (!string.IsNullOrEmpty(LinkInput.Password))
        {
            link.PasswordHash = ShareLinkPassword.Hash(link, LinkInput.Password);
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.ShareLinks.Add(link);
            await db.SaveChangesAsync();
        }

        Navigation.NavigateTo(Navigation.Uri);
    }

    private string? LinkUrl(ShareLink link) =>
        TokenProtector.Unprotect(link.ProtectedToken) is { } token
            ? Navigation.ToAbsoluteUri($"s/{token}").ToString()
            : null;

    private async Task RevokeAsync()
    {
        if (RevokeId is not { } linkId)
        {
            return;
        }

        var revokedAt = DateTimeOffset.UtcNow;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.ShareLinks
                .Where(link => link.Id == linkId)
                .Where(InScope)
                .Where(link => link.RevokedAt == null)
                .ExecuteUpdateAsync(setters => setters.SetProperty(link => link.RevokedAt, revokedAt));
        }

        Navigation.NavigateTo(Navigation.Uri);
    }

    private async Task LoadLinksAsync()
    {
        now = DateTimeOffset.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        var links = await db.ShareLinks
            .AsNoTracking()
            .Where(InScope)
            .OrderByDescending(link => link.CreatedAt)
            .ToListAsync();

        active = links.Where(link => link.GetStatus(now) == ShareLinkStatus.Active).ToList();
        past = links
            .Select(link => (link, link.GetStatus(now)))
            .Where(item => item.Item2 != ShareLinkStatus.Active)
            .ToList();
    }

    private static string DescribeViews(ShareLink link) =>
        link.MaxViews is { } maxViews
            ? $"{maxViews - link.ViewCount} of {maxViews} {(maxViews == 1 ? "view" : "views")} left"
            : "no view limit";

    private string DescribeExpiry(ShareLink link) =>
        link.ExpiresAt is { } expiresAt ? $"expires in {TimeLeft.Format(expiresAt, now)}" : "never expires";

    private static string DescribeStatus(ShareLinkStatus status) => status switch
    {
        ShareLinkStatus.Revoked => "Revoked",
        ShareLinkStatus.Expired => "Expired",
        ShareLinkStatus.UsedUp => "Used up",
        _ => "Active"
    };

    private Expression<Func<ShareLink, bool>> InScope =>
        link => link.PasteId == PasteId && link.ThreadId == ThreadId && link.FileId == FileId;

    private sealed class LinkInputModel
    {
        public bool CanAppend { get; set; }

        [AllowedValues(Lifetime.Forever, Lifetime.OneHour, Lifetime.OneDay, Lifetime.SevenDays)]
        public Lifetime Lifetime { get; set; } = Lifetime.SevenDays;

        [Range(1, 1000)]
        public int? MaxViews { get; set; }

        [StringLength(100, MinimumLength = 4)]
        public string? Password
        {
            get;
            set => field = string.IsNullOrEmpty(value) ? null : value;
        }
    }
}
