@using Mayfly.Core.Data
@using Mayfly.Web.Files
@using Mayfly.Web.Time

<ul class="desktop @(BelowPath ? "below-path" : null)">
    @foreach (var (item, count) in Folders)
    {
        <li class="item folder" style="@GridArea(item.GridColumn, item.GridRow)">
            <a href="@FolderHref(item.Id)" data-folder-target="@(ReadOnly ? null : item.Id)"
               data-share="@(ReadOnly ? null : $"desktop/folders/{item.Id}?share=true")">
                <span class="glyph">
                    <svg aria-hidden="true"><use href="#folder-glyph" /></svg>
                </span>
                <span class="text">
                    <span class="name">@item.Name</span>
                </span>
                <span class="left">@count @(count == 1 ? "item" : "items")</span>
            </a>
        </li>
    }

    @foreach (var (file, link) in Files)
    {
        var soon = TimeLeft.IsSoon(file.ExpiresAt, Now);
        var extension = Path.GetExtension(file.FileName).TrimStart('.').ToUpperInvariant();
        var timeLeft = file.ExpiresAt is { } expiry ? TimeLeft.Format(expiry, Now) : null;

        <li class="item @(soon ? "soon" : null)" style="@GridArea(file.GridColumn, file.GridRow)"
            data-expires="@file.ExpiresAt?.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">
            <a href="@FileHref(file.Id)" aria-describedby="card-@file.Id"
               aria-current="@(file.Id == CurrentFileId ? "true" : null)"
               data-download="@(ReadOnly ? null : $"files/{file.Id}/download")" data-file-id="@(ReadOnly ? null : file.Id)">
                <span class="glyph">
                    <svg aria-hidden="true"><use href="#file-glyph" /></svg>
                    @if (extension is { Length: > 0 and <= 4 })
                    {
                        <b>@extension</b>
                    }
                </span>
                <span class="text">
                    <span class="name">@file.FileName</span>
                    <span class="meta">@FileSize.Format(file.Size)</span>
                </span>
                <span class="left" data-time-left>@(timeLeft ?? "stays")</span>
            </a>

            <div class="card" id="card-@file.Id" role="tooltip">
                <header>
                    <b>@file.FileName</b>
                    <span>@(extension.Length > 0 ? $"{extension} file" : "File")</span>
                </header>

                <div class="when">
                    @if (file.ExpiresAt is { } expiresAt)
                    {
                        <span class="stamp @(soon ? "stamp-soon" : null)" data-time-left-stamp>@timeLeft left</span>
                        <small>gone <LocalTime Value="expiresAt" /></small>
                    }
                    else
                    {
                        <span class="stamp">No expiry</span>
                    }
                </div>

                <dl>
                    <dt>Size</dt>
                    <dd>@FileSize.Format(file.Size)</dd>
                    <dt>Uploaded</dt>
                    <dd><LocalTime Value="file.UploadedAt!.Value" /></dd>
                    @if (!ReadOnly)
                    {
                        <dt>Link</dt>
                        <dd>@link</dd>
                    }
                </dl>

                <footer>@(ReadOnly ? "Click to open" : "Click to open · double-click to download")</footer>
            </div>
        </li>
    }
</ul>

<p class="empty">@EmptyText</p>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<(Folder Folder, int Count)> Folders { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<(FileItem File, string Link)> Files { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<Guid, string> FolderHref { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<Guid, string> FileHref { get; set; } = default!;

    [Parameter, EditorRequired]
    public string EmptyText { get; set; } = default!;

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    [Parameter]
    public Guid? CurrentFileId { get; set; }

    [Parameter]
    public bool BelowPath { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    private static string? GridArea(int? column, int? row) => column is { } c && row is { } r ? $"grid-area: {r} / {c}" : null;
}
